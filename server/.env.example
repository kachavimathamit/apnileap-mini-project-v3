# --- Server ---
PORT=4000
NODE_ENV=development

# --- Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-before-any-real-deployment
# Idle session timeout in minutes (FR 5.1 - configurable session expiry)
SESSION_IDLE_MINUTES=60
# Absolute session lifetime in hours
SESSION_ABSOLUTE_HOURS=12
# Account lockout after N consecutive failed logins
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Set true only when serving over HTTPS (production)
COOKIE_SECURE=false

# --- Database ---
DATABASE_FILE=./data/portal.db

# --- Web origin allowed by CORS ---
WEB_ORIGIN=http://localhost:5173

# --- Freshness thresholds (NFR: configurable) ---
# A project not updated in this many days is flagged "stale"
STALE_PROJECT_DAYS=14

# --- Email (weekly report / notifications) ---
# console = write emails to server log instead of sending. Use smtp for real delivery.
MAIL_TRANSPORT=console
MAIL_FROM="ApniLeap Portfolio Portal <no-reply@apnileap.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Seed data ---
# Password applied to every demo account created by `npm run seed`
SEED_PASSWORD=Passw0rd!2026
